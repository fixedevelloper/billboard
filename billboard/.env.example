# Copy to .env and fill in real values for local development.
# spring-dotenv loads this file into the Spring Environment automatically.

DB_URL=jdbc:mysql://localhost:3306/adspace_market
DB_USERNAME=adspace
DB_PASSWORD=adspace

JWT_SECRET=change-me-in-production-change-me-in-production
JWT_EXPIRATION_MINUTES=60

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=adspace
MINIO_SECRET_KEY=adspace123
MINIO_BUCKET=adspace-market-media
MINIO_PRESIGNED_URL_EXPIRY_MINUTES=60

# Mailpit (docker-compose) by default; point at a real SMTP relay in production.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_ENABLED=true
MAIL_FROM=no-reply@adspacemarket.com
MAIL_FROM_NAME=AdSpace Market

# Orders left PENDING_PAYMENT/DELEGATED longer than this are auto-cancelled and released.
ORDER_EXPIRATION_MINUTES=60
ORDER_EXPIRATION_CHECK_INTERVAL_MS=60000
